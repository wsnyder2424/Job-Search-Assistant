# Supabase — from your project's API settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — powers photo label extraction on /api/extract-medication.
# Optional: without it the camera flow still works, it just falls back to
# manual entry instead of pre-filling the form.
ANTHROPIC_API_KEY=sk-ant-...
